generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoMovimiento {
  compra
  ajuste

  @@map("tipo_movimiento")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String   @db.VarChar(100)
  correo         String   @unique @db.VarChar(150)
  contrasenaHash String   @map("contrasena_hash") @db.VarChar(255)
  fechaCreacion  DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  categorias    Categoria[]
  subcategorias Subcategoria[]
  productos     Producto[]
  tokens        TokenRecuperacion[]

  @@map("usuario")
}

model Categoria {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  icono     String   @db.VarChar(50)
  usuarioId Int      @map("usuario_id")
  estado    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  subcategorias Subcategoria[]

  @@index([usuarioId, estado], map: "idx_categoria_usuario_estado")
  @@map("categoria")
}

model Subcategoria {
  id          Int      @id @default(autoincrement())
  usuarioId   Int      @map("usuario_id")
  categoriaId Int      @map("categoria_id")
  nombre      String   @db.VarChar(100)
  icono       String?  @db.VarChar(50)
  estado      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  categoria Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  productos Producto[]

  @@index([usuarioId, estado], map: "idx_subcategoria_usuario_estado")
  @@index([categoriaId], map: "idx_subcategoria_categoria")
  @@map("subcategoria")
}

model Producto {
  id             Int      @id @default(autoincrement())
  nombre         String   @db.VarChar(150)
  subcategoriaId Int      @map("subcategoria_id")
  descripcion    String?  @db.VarChar(500)
  usuarioId      Int      @map("usuario_id")
  stock          Int      @default(0)
  estado         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  subcategoria Subcategoria           @relation(fields: [subcategoriaId], references: [id], onDelete: Restrict)
  usuario      Usuario                @relation(fields: [usuarioId], references: [id])
  ventas       Venta[]
  movimientos  MovimientoInventario[]

  @@index([usuarioId, estado], map: "idx_producto_usuario_estado")
  @@index([subcategoriaId], map: "idx_producto_subcategoria")
  @@map("producto")
}

model Venta {
  id         Int      @id @default(autoincrement())
  productoId Int      @map("producto_id")
  cantidad   Int
  fecha      DateTime @default(now()) @db.Timestamptz(6)

  producto Producto @relation(fields: [productoId], references: [id])

  @@index([productoId, fecha(sort: Desc)], map: "idx_venta_producto_fecha")
  @@map("venta")
}

model MovimientoInventario {
  id            Int            @id @default(autoincrement())
  productoId    Int            @map("producto_id")
  tipo          TipoMovimiento
  cantidad      Int
  stockAnterior Int            @map("stock_anterior")
  fecha         DateTime       @default(now()) @db.Timestamptz(6)

  producto Producto @relation(fields: [productoId], references: [id])

  @@index([productoId, fecha(sort: Desc)], map: "idx_movimiento_producto_fecha")
  @@map("movimiento_inventario")
}

model TokenRecuperacion {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiraEn  DateTime  @map("expira_en") @db.Timestamptz(6)
  usadoEn   DateTime? @map("usado_en") @db.Timestamptz(6)
  creadoEn  DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "idx_token_usuario")
  @@map("token_recuperacion")
}
